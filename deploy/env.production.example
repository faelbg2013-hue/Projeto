# Names only. Do not put real passwords, JWT secrets, or a private key in this file.
# Export the values in the operator shell or in an untracked env file.
# docker-compose.production.yml refuses to start when a required value is empty.
# PUBLIC_ORIGIN is the proxy origin, with scheme and host and without a path.
# A local rehearsal may use http://127.0.0.1:8080. A public launch uses https on the operator domain.
# Do not reuse the development passwords from .env.example.

PUBLIC_ORIGIN=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
DEFAULT_PUBLIC_TENANT_ID=
TRUST_PROXY=1
LOG_LEVEL=log
TLS_CERT_DIR=
HTTP_PORT=8080
HTTPS_PORT=443
