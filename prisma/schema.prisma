generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ScheduleExceptionType {
  BLOCK
  OPEN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PointsTransactionType {
  EARN
  REDEEM
  REDEEM_REVERSAL
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
}

enum BookingMode {
  NORMAL
  POINTS
}

model Tenant {
  id        String        @id @default(uuid()) @db.Char(36)
  name      String        @db.VarChar(120)
  slug      String        @unique @db.VarChar(80)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  users         User[]
  sessions      UserSession[]
  clients              Client[]
  professionals        Professional[]
  services             Service[]
  schedules            ProfessionalSchedule[]
  timeBlocks           ProfessionalTimeBlock[]
  scheduleExceptions   ProfessionalScheduleException[]
  appointments         Appointment[]
  pointsTransactions   PointsTransaction[]

  @@map("tenants")
}

model User {
  id           String        @id @default(uuid()) @db.Char(36)
  tenantId     String        @db.Char(36)
  name         String        @db.VarChar(160)
  email        String        @db.VarChar(255)
  passwordHash String        @db.VarChar(255)
  role         UserRole
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  sessions     UserSession[]
  client             Client?
  professional       Professional?
  pointsAuthored     PointsTransaction[] @relation("PointsAuthor")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @db.Char(36)
  tenantId         String    @db.Char(36)
  refreshTokenHash String    @unique @db.Char(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant           Tenant    @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("user_sessions")
}

model Client {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  userId    String   @unique @db.Char(36)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments       Appointment[]
  pointsTransactions PointsTransaction[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("clients")
}

model Professional {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  userId      String   @unique @db.Char(36)
  displayName String   @db.VarChar(120)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant             Tenant                        @relation(fields: [tenantId], references: [id])
  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules          ProfessionalSchedule[]
  timeBlocks         ProfessionalTimeBlock[]
  scheduleExceptions ProfessionalScheduleException[]
  appointments       Appointment[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("professionals")
}

/// Horário recorrente, só com hora de parede. dayOfWeek: 1 segunda … 7 domingo.
model ProfessionalSchedule {
  id             String       @id @default(uuid()) @db.Char(36)
  tenantId       String       @db.Char(36)
  professionalId String       @db.Char(36)
  dayOfWeek      Int
  startTime      String       @db.Char(5)
  endTime        String       @db.Char(5)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, professionalId, dayOfWeek])
  @@map("professional_schedules")
}

/// Período absoluto em que o profissional não atende. Instantes em UTC; a leitura usa America/Sao_Paulo.
model ProfessionalTimeBlock {
  id             String       @id @default(uuid()) @db.Char(36)
  tenantId       String       @db.Char(36)
  professionalId String       @db.Char(36)
  startAt        DateTime
  endAt          DateTime
  reason         String?      @db.VarChar(240)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, professionalId, startAt, endAt])
  @@map("professional_time_blocks")
}

/// Exceção de um dia. Horários nulos significam o dia inteiro na timezone da agenda.
model ProfessionalScheduleException {
  id             String                @id @default(uuid()) @db.Char(36)
  tenantId       String                @db.Char(36)
  professionalId String                @db.Char(36)
  date           String                @db.Char(10)
  startTime      String?               @db.Char(5)
  endTime        String?               @db.Char(5)
  type           ScheduleExceptionType
  reason         String?               @db.VarChar(240)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  professional   Professional          @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, professionalId, date])
  @@map("professional_schedule_exceptions")
}

model Service {
  id              String   @id @default(uuid()) @db.Char(36)
  tenantId        String   @db.Char(36)
  name            String   @db.VarChar(120)
  description     String?  @db.VarChar(1000)
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes   Int
  points            Int      @default(0)
  redemptionPoints  Int?
  isActive          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@index([tenantId])
  @@map("services")
}

/// Atendimento preservado. Preço, nome, duração, pontos ganhos e resgate são o serviço no momento da criação.
model Appointment {
  id                              String            @id @default(uuid()) @db.Char(36)
  tenantId                        String            @db.Char(36)
  clientId                        String            @db.Char(36)
  professionalId                  String            @db.Char(36)
  serviceId                       String            @db.Char(36)
  startAt                         DateTime
  endAt                           DateTime
  status                          AppointmentStatus @default(CONFIRMED)
  notes                           String?           @db.VarChar(500)
  serviceNameSnapshot             String            @db.VarChar(120)
  servicePriceSnapshot            Decimal           @db.Decimal(10, 2)
  serviceDurationMinutesSnapshot  Int
  pointsSnapshot                  Int               @default(0)
  bookingMode                     BookingMode       @default(NORMAL)
  redemptionPointsSnapshot        Int?
  idempotencyKey                  String?           @db.VarChar(80)
  cancelledAt                     DateTime?
  completedAt                     DateTime?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  tenant                          Tenant            @relation(fields: [tenantId], references: [id])
  client                          Client            @relation(fields: [clientId], references: [id])
  professional                    Professional      @relation(fields: [professionalId], references: [id])
  service                         Service              @relation(fields: [serviceId], references: [id])
  pointsTransactions              PointsTransaction[]

  @@unique([tenantId, clientId, idempotencyKey])
  @@index([tenantId, professionalId, startAt])
  @@index([tenantId, clientId, startAt])
  @@map("appointments")
}

/// Extrato imutável. O saldo é a soma dos créditos menos a soma dos débitos. points é sempre positivo.
model PointsTransaction {
  id                String                 @id @default(uuid()) @db.Char(36)
  tenantId          String                 @db.Char(36)
  clientId          String                 @db.Char(36)
  type              PointsTransactionType
  points            Int
  reason            String                 @db.VarChar(240)
  appointmentId           String?                @db.Char(36)
  earnAppointmentId       String?                @db.Char(36)
  redeemAppointmentId     String?                @db.Char(36)
  reversalOfTransactionId String?                @unique @db.Char(36)
  createdByUserId         String?                @db.Char(36)
  createdAt               DateTime               @default(now())
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id])
  client                  Client                 @relation(fields: [clientId], references: [id])
  appointment             Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  reversalOf              PointsTransaction?     @relation("PointsReversal", fields: [reversalOfTransactionId], references: [id], onDelete: Restrict)
  reversedBy              PointsTransaction?     @relation("PointsReversal")
  createdBy               User?                  @relation("PointsAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, earnAppointmentId])
  @@unique([tenantId, redeemAppointmentId])
  @@index([tenantId, clientId, createdAt])
  @@index([appointmentId])
  @@map("points_transactions")
}
