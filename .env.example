# Local development placeholders. Replace every secret outside this machine.
# Never commit a real .env file.
# These JWT secrets, seed passwords and database passwords are development-only.
# Do not reuse them in production. NODE_ENV=production rejects the JWT placeholders
# and refuses to run this development seed.

NODE_ENV=development
PORT=43111

DATABASE_URL=mysql://ravion:ravion_dev_password@127.0.0.1:3306/ravion_barber

# Development only. Production requires a unique value of at least 32 characters.
JWT_SECRET=dev-only-change-me-ravion-access-secret
JWT_REFRESH_SECRET=dev-only-change-me-ravion-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Tenant de desenvolvimento usado no cadastro público. Não é uma barbearia.
DEFAULT_PUBLIC_TENANT_ID=3f1c2a7e-6b4d-4e8a-9c21-0a1b2c3d4e5f
TENANT_NAME=Ravion Barber Web
TENANT_SLUG=web
ADMIN_TENANT_ID=3f1c2a7e-6b4d-4e8a-9c21-0a1b2c3d4e5f
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@ravion.local
# Development seed password only. Not for production.
ADMIN_PASSWORD=change-me-admin-password

# Dados mínimos de desenvolvimento. O seed não sobrescreve senha de usuário existente.
SEED_CLIENT_NAME=Cliente Teste
SEED_CLIENT_EMAIL=cliente@ravion.local
SEED_CLIENT_PASSWORD=change-me-client-password
SEED_PROFESSIONAL_NAME=Profissional Teste
SEED_PROFESSIONAL_EMAIL=profissional@ravion.local
SEED_PROFESSIONAL_PASSWORD=change-me-professional-password
SEED_PROFESSIONAL_DISPLAY_NAME=Profissional

CORS_ORIGINS=http://localhost:43110,http://127.0.0.1:43110

# OpenAPI UI. When omitted, Swagger stays enabled outside production.
SWAGGER_ENABLED=true

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Auth limits are requests per AUTH_THROTTLE_TTL_MS window, per client IP.
# The window is milliseconds. These routes also count toward THROTTLE_LIMIT.
AUTH_THROTTLE_TTL_MS=60000
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_REFRESH_LIMIT=30

# false or 0: do not trust X-Forwarded-For. A positive integer is the number of
# trusted reverse proxies, for example 1. The value true is rejected.
TRUST_PROXY=false

LOG_LEVEL=log

# Empty means same origin and is the recommended production value.
# A production build rejects a missing value, localhost and an absolute http URL.
# Flutter uses the absolute API URL and the JSON tokens instead.
VITE_API_URL=
VITE_TENANT_SLUG=web

# Docker Compose — development database only.
MYSQL_ROOT_PASSWORD=ravion_root_dev
MYSQL_DATABASE=ravion_barber
MYSQL_USER=ravion
MYSQL_PASSWORD=ravion_dev_password
MYSQL_PORT=3306
